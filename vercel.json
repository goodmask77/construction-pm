{
  "rewrites": [
    {
      "source": "/prep",
      "destination": "/ops/index.html"
    },
    {
      "source": "/partner/v1/:ep*",
      "destination": "/api/partner-api?ep=:ep*"
    },
    {
      "source": "/v/:code",
      "destination": "/api/mail-sync?vgo=:code"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-daily",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron-daily",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/cron-daily",
      "schedule": "0 13 * * 0-4"
    },
    {
      "path": "/api/mail-manage",
      "schedule": "10 * * * *"
    },
    {
      "path": "/api/mail-sync",
      "schedule": "30 13,14,15 * * *"
    },
    {
      "path": "/api/joya-intraday",
      "schedule": "0,15,30,45 3-13 * * *"
    },
    {
      "path": "/api/boss-sync",
      "schedule": "7 * * * *"
    },
    {
      "path": "/api/eats-rhythm",
      "schedule": "50 13 * * *"
    },
    {
      "path": "/api/inline-sync",
      "schedule": "25 * * * *"
    },
    {
      "path": "/api/line-webhook?warm=1",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/hr",
      "schedule": "40 14 * * *"
    },
    {
      "path": "/api/hr",
      "schedule": "*/20 1-13 * * *"
    }
  ]
}